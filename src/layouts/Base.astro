---
import "@fontsource-variable/inter/wght.css";
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/instrument-serif/latin-400-italic.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import serifLatin from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import serifItalic from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import "../styles/global.css";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Pages that aren't a place of their own (the 404): no canonical URL, kept out of search. */
  noindex?: boolean;
}

const { title = site.title, description = site.description, image = "og.png", noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8f7f4" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {noindex ? null : <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label={`${site.name}, home`}>{site.name}</a>
      <nav aria-label="Main">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href={site.links.github} rel="me">GitHub<span aria-hidden="true"> ↗</span></a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="wrap">
      <div class="site-footer">
        <p>© {new Date().getFullYear()} {site.name} · {site.location}</p>
        <p>
          {site.links.email ? <><a href={`mailto:${site.links.email}`}>{site.links.email}</a> · </> : null}
          <a href={site.links.github} rel="me">GitHub</a>
        </p>
      </div>
    </footer>

    <script is:inline>
      // Clips start once the page has loaded and play only while on screen (not by themselves with
      // reduced motion). Pause holds a clip until Play; "Play with sound" starts the conversation
      // from the top and shows what's being said under it. Back from another page or tab, a clip
      // is muted again and carries on if it's on screen.
      (() => {
        const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const loaded = new Promise((r) => (document.readyState === "complete" ? r() : addEventListener("load", r, { once: true })));
        for (const clip of document.querySelectorAll("[data-clip]")) {
          const video = clip.querySelector("video");
          if (!video) continue;
          const play = clip.querySelector("[data-play]");
          const sound = clip.querySelector("[data-sound]");
          const cue = clip.querySelector("[data-cue]");
          let inView = false;
          let held = still;
          const run = () => inView && !held && video.play().catch(() => {});
          const render = () => {
            clip.toggleAttribute("data-paused", video.paused);
            clip.toggleAttribute("data-audible", !video.muted);
            play?.setAttribute("aria-label", video.paused ? "Play the clip" : "Pause the clip");
          };
          for (const e of ["play", "pause", "volumechange"]) video.addEventListener(e, render);
          loaded.then(() =>
            new IntersectionObserver(([e]) => ((inView = e.isIntersecting) ? run() : video.pause()), { threshold: 0.3 }).observe(video),
          );
          play?.addEventListener("click", () => {
            held = !video.paused;
            held ? video.pause() : video.play().catch(() => {});
          });
          sound?.addEventListener("click", () => {
            const on = video.muted;
            video.muted = !on;
            if (!on) return;
            const track = video.textTracks[0];
            if (track && cue && track.mode === "disabled") {
              track.mode = "hidden";
              track.addEventListener("cuechange", () => (cue.textContent = track.activeCues?.[0]?.text ?? ""));
            }
            held = false;
            video.currentTime = 0;
            video.play().catch(() => {});
          });
          addEventListener("pagehide", () => (video.muted = true));
          addEventListener("pageshow", (e) => e.persisted && run());
          document.addEventListener("visibilitychange", () => document.visibilityState === "visible" && run());
        }
      })();
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
  }

  .brand {
    font-weight: 550;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  nav {
    display: flex;
    gap: clamp(0.85rem, 3vw, 1.75rem);
    font-size: 0.9375rem;
    color: var(--text-2);
  }

  nav a {
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--text);
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 3rem 2.5rem;
    margin-top: clamp(4rem, 10vw, 8rem);
    border-top: 1px solid var(--line);
    color: var(--text-3);
    font-size: 0.875rem;
  }
</style>
