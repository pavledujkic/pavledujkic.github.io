---
import Base from "../layouts/Base.astro";
import Device from "../components/Device.astro";
import { projects } from "../projects";
import { site } from "../site";
---

<Base>
  {projects[0]?.clip ? <link slot="head" rel="preload" as="image" href={`/${projects[0].clip.poster}`} fetchpriority="high" /> : null}
  <section class="intro wrap" aria-labelledby="hello">
    <p class="label">{site.role} · {site.location}</p>
    <h1 id="hello" class="serif">I build software that feels <em>instant.</em></h1>
    <p class="lede">
      Fast, focused products, made with care for the last hundred milliseconds. Lately: realtime AI on the phone.
    </p>
  </section>

  <section id="work" class="work wrap" aria-labelledby="work-title">
    <h2 id="work-title" class="label">Selected work</h2>
    {
      projects.map((p) => (
        <article class="project" style={`--a:${p.colors[0]};--b:${p.colors[1]}`}>
          {p.clip ? <Device project={p} /> : null}
          <div class="about-project">
            <p class="label">
              {p.year} · {p.platforms}
            </p>
            <h3 class="serif">{p.title}</h3>
            <p class="tagline">{p.tagline}</p>
            <p class="summary">{p.summary}</p>
            <dl class="stats">
              {p.stats.map((s) => (
                <div>
                  <dt>{s.value}</dt>
                  <dd>{s.label}</dd>
                </div>
              ))}
            </dl>
            {p.page ? (
              <a class="more" href={`/work/${p.slug}/`}>
                Read the case study<span aria-hidden="true">→</span>
              </a>
            ) : null}
          </div>
        </article>
      ))
    }
    <p class="next">More projects are on their way.</p>
  </section>

  <section id="about" class="about wrap" aria-labelledby="about-title">
    <h2 id="about-title" class="label">About</h2>
    <div class="about-body">
      <p class="serif big">
        I’m Pavle, a software engineer in Belgrade, Serbia. This is where I put the things I build, starting with Twain.
      </p>
      <p class="links">
        {site.links.email ? <a href={`mailto:${site.links.email}`}>{site.links.email}</a> : null}
        <a href={site.links.github} rel="me">GitHub</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-top: clamp(3.5rem, 12vw, 9rem);
    padding-bottom: clamp(3.5rem, 9vw, 7rem);
  }

  /* A quiet arrival: the three lines rise in, one after another (CSS only). */
  @media (prefers-reduced-motion: no-preference) {
    .intro > * {
      animation: rise 0.9s var(--ease) both;
    }
    .intro > :nth-child(2) {
      animation-delay: 0.08s;
    }
    .intro > :nth-child(3) {
      animation-delay: 0.18s;
    }
    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(0.6rem);
      }
    }
  }

  .intro h1 {
    margin-top: 1.1rem;
    /* In em, not ch: the same line breaks before and after the web font arrives. */
    max-width: 6em;
    font-size: clamp(3rem, 9.5vw, 6.75rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .intro h1 em {
    font-style: italic;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.06em;
  }

  .lede {
    margin-top: 1.75rem;
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--text-2);
  }

  .work {
    padding-block: 1rem;
  }

  .project {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    margin-top: 1.75rem;
    padding: clamp(2.25rem, 6vw, 4.5rem) clamp(1.25rem, 5vw, 4.5rem);
    border: 1px solid var(--line);
    border-radius: 1.75rem;
    background:
      radial-gradient(120% 80% at 0% 0%, color-mix(in srgb, var(--a) 7%, transparent), transparent 60%),
      radial-gradient(100% 80% at 100% 100%, color-mix(in srgb, var(--b) 6%, transparent), transparent 60%),
      var(--bg-raised);
    overflow: hidden;
  }

  @media (min-width: 52rem) {
    .project {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      justify-items: start;
    }
  }

  .about-project {
    max-width: 30rem;
  }

  .about-project h3 {
    margin-top: 0.6rem;
    font-size: clamp(2.75rem, 6vw, 4rem);
    line-height: 1;
  }

  .tagline {
    margin-top: 0.5rem;
    font-size: 1.125rem;
    color: var(--text);
  }

  .summary {
    margin-top: 1rem;
    color: var(--text-2);
  }

  .stats {
    display: grid;
    gap: 1.1rem;
    margin: 2rem 0 0;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 36rem) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stats dt {
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .stats dd {
    margin: 0.45rem 0 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text-3);
  }

  .more {
    display: inline-block;
    margin-top: 2rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    padding-bottom: 0.15rem;
    transition: border-color 0.2s var(--ease);
  }

  .more:hover {
    border-color: currentColor;
  }

  .more span {
    display: inline-block;
    margin-left: 0.35em;
    transition: transform 0.2s var(--ease);
  }

  .more:hover span {
    transform: translateX(3px);
  }

  .next {
    margin-top: 1.5rem;
    color: var(--text-3);
    font-size: 0.9375rem;
  }

  .about {
    padding-top: clamp(4.5rem, 10vw, 8rem);
  }

  .about-body {
    margin-top: 1.25rem;
    max-width: 44rem;
  }

  .big {
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    color: var(--text-2);
  }
</style>
